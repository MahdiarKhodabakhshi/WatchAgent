{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent/planner-output.schema.json",
  "title": "Codex Planner Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "observations",
    "risks",
    "recommended_order",
    "tasks"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[A-Za-z0-9._-]+$"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "status",
          "source",
          "created_at",
          "risk",
          "area",
          "approval_required",
          "approved_by",
          "objective",
          "context",
          "implementation_plan",
          "acceptance_criteria",
          "test_plan",
          "files_likely_to_change",
          "forbidden_changes",
          "done_definition"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-[A-Za-z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "rejected",
              "in_progress",
              "implemented",
              "needs_revision",
              "blocked"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "approval_required": {
            "type": "boolean"
          },
          "approved_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "implementation_plan": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_plan": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files_likely_to_change": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "done_definition": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
