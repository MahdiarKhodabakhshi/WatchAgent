# Configuration for scripts/agent-telegram-bot.py
#
# Copy this file to .agent/telegram.env (gitignored) and fill in real values,
# or export these variables in your shell. Environment variables take
# precedence over this file. Never commit real values.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of Telegram chat IDs permitted to issue commands.
# To find yours: set the token above, message your bot, then run
#   scripts/agent-telegram-bot.py --print-chat-ids
# (that mode needs only the token and never runs commands).
# The bot refuses to start if this is empty (fail closed).
TELEGRAM_ALLOWED_CHAT_IDS=
